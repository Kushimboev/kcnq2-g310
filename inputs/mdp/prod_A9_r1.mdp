; production, scaled charges, widened gate: both G310 CA-CA diagonals held at 0.90 nm (k 15000, x and y only); S5/S6 ends restrained to the starting frame, which was taken from a steered widening run; field 0.06321 V/nm
define = -DPOSRES_ENDS
integrator = md
tcoupl = v-rescale
tc-grps = System
tau-t = 1.0
ref-t = 303.15
comm-mode = Linear
comm-grps = Protein_POPC Water_and_ions
nstcalcenergy = 100
cutoff-scheme = Verlet
nstlist = 20
pbc = xyz
coulombtype = PME
rcoulomb = 1.0
vdwtype = Cut-off
vdw-modifier = None
rvdw = 1.0
DispCorr = EnerPres
constraints = h-bonds
constraint-algorithm = LINCS
pcoupl = C-rescale
pcoupltype = semiisotropic
tau-p = 5.0
ref-p = 1.0 1.0
compressibility = 4.5e-5 4.5e-5
refcoord-scaling = com
dt = 0.002
nsteps = 150000000
nstxout-compressed = 5000
compressed-x-grps = System
nstenergy = 5000
nstlog = 5000
gen-vel = yes
gen-temp = 303.15
gen-seed = 11917
continuation = no
electric-field-z = 0.06321 0 0 0
pull = yes
pull-ncoords = 2
pull-ngroups = 4
pull-group1-name = G310_A
pull-group2-name = G310_C
pull-group3-name = G310_B
pull-group4-name = G310_D
pull-nstxout = 5000
pull-nstfout = 5000
pull-coord1-type = umbrella
pull-coord1-geometry = distance
pull-coord1-groups = 1 2
pull-coord1-dim = Y Y N
pull-coord1-k = 15000
pull-coord1-rate = 0
pull-coord1-init = 0.90
pull-coord1-start = no
pull-coord2-type = umbrella
pull-coord2-geometry = distance
pull-coord2-groups = 3 4
pull-coord2-dim = Y Y N
pull-coord2-k = 15000
pull-coord2-rate = 0
pull-coord2-init = 0.90
pull-coord2-start = no
