; eqA: NVT 250 ps, dt 1 fs, heavy atoms (POSRES) + lipid P z (POSRES_LIPID); -r = starting frame
define = -DPOSRES -DPOSRES_LIPID
integrator = md
tcoupl = v-rescale
tc-grps = System
tau-t = 1.0
ref-t = 303.15
comm-mode = Linear
comm-grps = Protein_POPC Water_and_ions
nstcalcenergy = 100
constraints = h-bonds
constraint-algorithm = LINCS
cutoff-scheme = Verlet
nstlist = 20
pbc = xyz
coulombtype = PME
rcoulomb = 1.2
vdwtype = Cut-off
vdw-modifier = Force-switch
rvdw-switch = 1.0
rvdw = 1.2
DispCorr = no
dt = 0.001
nsteps = 250000
nstxout-compressed = 5000
compressed-x-grps = System
nstenergy = 1000
nstlog = 1000
gen-vel = yes
gen-temp = 303.15
gen-seed = GENSEED
continuation = no
