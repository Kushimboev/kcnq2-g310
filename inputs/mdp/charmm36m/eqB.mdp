; eqB: NPT 1 ns, backbone (POSRES_BB); -r = starting frame
define = -DPOSRES_BB
integrator = md
tcoupl = v-rescale
tc-grps = System
tau-t = 1.0
ref-t = 303.15
comm-mode = Linear
comm-grps = Protein_POPC Water_and_ions
nstcalcenergy = 100
constraints = h-bonds
constraint-algorithm = LINCS
cutoff-scheme = Verlet
nstlist = 20
pbc = xyz
coulombtype = PME
rcoulomb = 1.2
vdwtype = Cut-off
vdw-modifier = Force-switch
rvdw-switch = 1.0
rvdw = 1.2
DispCorr = no
pcoupl = C-rescale
pcoupltype = semiisotropic
tau-p = 5.0
ref-p = 1.0 1.0
compressibility = 4.5e-5 4.5e-5
refcoord-scaling = com
dt = 0.002
nsteps = 500000
nstxout-compressed = 5000
compressed-x-grps = System
nstenergy = 5000
nstlog = 5000
continuation = yes
gen-vel = no
