; production CHARMM36m, 565 mV (E = 0.565/Lz), S5/S6 ends restrained to cryo-EM (POSRES_ENDS, -r ref); as the Amber14sb production file, with CHARMM36m nonbonded settings
define = -DPOSRES_ENDS
integrator = md
tcoupl = v-rescale
tc-grps = System
tau-t = 1.0
ref-t = 303.15
comm-mode = Linear
comm-grps = Protein_POPC Water_and_ions
nstcalcenergy = 100
constraints = h-bonds
constraint-algorithm = LINCS
cutoff-scheme = Verlet
nstlist = 20
pbc = xyz
coulombtype = PME
rcoulomb = 1.2
vdwtype = Cut-off
vdw-modifier = Force-switch
rvdw-switch = 1.0
rvdw = 1.2
DispCorr = no
pcoupl = C-rescale
pcoupltype = semiisotropic
tau-p = 5.0
ref-p = 1.0 1.0
compressibility = 4.5e-5 4.5e-5
refcoord-scaling = com
dt = 0.002
nsteps = 150000000
nstxout-compressed = 5000
compressed-x-grps = System
nstenergy = 5000
nstlog = 5000
gen-vel = yes
gen-temp = 303.15
gen-seed = GENSEED
continuation = no
electric-field-z = EFIELD 0 0 0
