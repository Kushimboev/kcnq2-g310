; CHARMM36m energy minimisation: system converted from the Amber14sb one, hydrogens from pdb2gmx
integrator = steep
emtol = 1000
emstep = 0.01
nsteps = 50000
cutoff-scheme = Verlet
nstlist = 20
pbc = xyz
coulombtype = PME
rcoulomb = 1.2
vdwtype = Cut-off
vdw-modifier = Force-switch
rvdw-switch = 1.0
rvdw = 1.2
DispCorr = no
