; NVT 250 ps, 1 fs, heavy + lipid P(z)
define = -DPOSRES -DPOSRES_LIPID
integrator = md
tcoupl = v-rescale
tc-grps = System
tau-t = 1.0
ref-t = 303.15
comm-mode = Linear
comm-grps = Protein_POPC Water_and_ions
nstcalcenergy = 100
cutoff-scheme = Verlet
nstlist = 20
pbc = xyz
coulombtype = PME
rcoulomb = 1.0
vdwtype = Cut-off
vdw-modifier = None
rvdw = 1.0
DispCorr = EnerPres
constraints = h-bonds
constraint-algorithm = LINCS
dt = 0.001
nsteps = 250000
nstxout-compressed = 5000
compressed-x-grps = System
nstenergy = 1000
nstlog = 1000
gen-vel = yes
gen-temp = 303.15
gen-seed = 20260917
continuation = no
