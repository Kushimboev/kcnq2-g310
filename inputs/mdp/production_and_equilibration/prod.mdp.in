; production, deposited gate: S5/S6 end backbone restraints to cryo-EM (-r A_system.gro), field EFIELD V/nm
define = -DPOSRES_ENDS
integrator = md
tcoupl = v-rescale
tc-grps = System
tau-t = 1.0
ref-t = 303.15
comm-mode = Linear
comm-grps = Protein_POPC Water_and_ions
nstcalcenergy = 100
cutoff-scheme = Verlet
nstlist = 20
pbc = xyz
coulombtype = PME
rcoulomb = 1.0
vdwtype = Cut-off
vdw-modifier = None
rvdw = 1.0
DispCorr = EnerPres
constraints = h-bonds
constraint-algorithm = LINCS
pcoupl = C-rescale
pcoupltype = semiisotropic
tau-p = 5.0
ref-p = 1.0 1.0
compressibility = 4.5e-5 4.5e-5
refcoord-scaling = com
dt = 0.002
nsteps = 150000000
nstxout-compressed = 5000
compressed-x-grps = System
nstenergy = 5000
nstlog = 5000
gen-vel = yes
gen-temp = 303.15
gen-seed = GENSEED
continuation = no
electric-field-z = EFIELD 0 0 0
